# Local LLM (default): any OpenAI-compatible server.
# Ollama http://localhost:11434 | LM Studio http://localhost:1234
# llama.cpp http://localhost:8080 | vLLM http://localhost:8000
LOCAL_LLM_BASE_URL=http://localhost:11434
# Only for servers started with an API key (e.g. vLLM --api-key)
LOCAL_LLM_API_KEY=

# Hosted LLM API keys (optional; only needed with DEFAULT_LLM_PROVIDER=anthropic|openai)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# GitHub Access (Optional for public repos, recommended for higher rate limits or private repos)
GITHUB_TOKEN=

# Global Defaults
# local | anthropic | openai | mock
DEFAULT_LLM_PROVIDER=local
# Empty = provider default (local: qwen2.5:7b). Applies only to DEFAULT_LLM_PROVIDER.
DEFAULT_LLM_MODEL=
MAX_COST_USD=1.00
LOG_LEVEL=INFO
