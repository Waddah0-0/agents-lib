{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "src/**",
      "scripts/**",
      "*.ts",
      "*.json",
      "!src/api/schema.d.ts",
      "!src/styles/theme.css",
      "!src/styles/fonts.css",
      "!openapi.json",
      "!package-lock.json"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "css": {
    "parser": { "cssModules": true },
    "formatter": { "enabled": false },
    "linter": { "enabled": true }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "a11y": { "noAutofocus": "off" },
      "style": { "noNonNullAssertion": "error", "noDescendingSpecificity": "off" }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
